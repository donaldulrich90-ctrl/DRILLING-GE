# ============================================================
#  Pack de démarrage — SERVEUR LOCAL (au site, sans internet)
#  Copiez ce fichier en « .env.local » et remplissez les 3 lignes
#  marquées (à remplir). Puis lancez : ./scripts/start-local.sh
# ============================================================

# Adresse du serveur EN LIGNE (à remplir)
SYNC_REMOTE_URL=https://TON-SERVEUR-EN-LIGNE

# Compte ADMIN de ton entreprise sur le serveur en ligne (à remplir)
SYNC_USERNAME=admin_bombore
SYNC_PASSWORD=TON_MOT_DE_PASSE

# (optionnel) fréquence de synchro en minutes — défaut 15
SYNC_INTERVAL_MINUTES=15

# (optionnel) port local — défaut 3000
PORT=3000
